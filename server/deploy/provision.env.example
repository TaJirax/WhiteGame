# Copy to /etc/whitegame-provision.env with owner root:root and mode 0600.
# Replace the endpoint and generate both tokens before starting the service.
WG_INTERFACE=wg0
WG_ENDPOINT=vpn.example.com:51820
WG_NETWORK=10.8.0.0/24
WG_DNS=1.1.1.1,1.0.0.1
WG_ALLOWED_IPS=0.0.0.0/0
WG_MTU=1280
WG_KEEPALIVE=25
WG_ENROLLMENT_TOKEN=
WG_ADMIN_TOKEN=
WG_DATABASE=/var/lib/whitegame-provision/peers.sqlite3
WG_BIN=/usr/bin/wg
WG_BIND_HOST=127.0.0.1
WG_BIND_PORT=8080
